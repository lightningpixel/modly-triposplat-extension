# Per-extension virtualenv created by setup.py at install time
venv/

# Python caches
__pycache__/
*.pyc

# vendor/ IS committed on purpose (pure-Python model code, no runtime fetch)

# Local dev session backups — never ship
_backup_session_*/

# Benchmark render output — PNG/GLB/npz dumps, regenerated by the bench scripts.
**/bench_out/

# Dev/internal — kept locally, never shipped to users
_bench_phase_a.py
_bench_phase_b.py
splatforge/bench.py
splatforge/DESIGN.md
splatforge/PROGRESS.md

# Closed Phase A field-space optimizer — dev-only experiment, kept locally only.
# Not imported by the shipped runtime (render/* + tsdf.py are self-contained).
splatforge/pipeline.py
splatforge/optimize.py
splatforge/fields.py
splatforge/remesh.py
splatforge/smooth.py
splatforge/competition/

# Debug scratch — dev-only scripts and data dumps, never shipped to users
debug/
