# Per-extension virtualenv created by setup.py at install time
venv/

# Python caches
__pycache__/
*.pyc

# vendor/ IS committed on purpose (pure-Python model code, no runtime fetch)

# Local dev session backups — never ship
_backup_session_*/

# Benchmark render output — PNG/GLB/npz dumps, regenerated by the bench scripts.
# The bench *scripts* (_bench_phase_*.py, splatforge/bench.py, competition/*.py)
# are kept; only their heavy output is ignored.
**/bench_out/

# Debug scratch data dumps (the debug/*.py scripts are kept, the data is not)
debug/*.npz
debug/*.txt
